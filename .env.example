# Keep credentials only on the backend. Existing .env is never overwritten.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
TRIPO_API_KEY=
TRIPO_MODEL_VERSION=P2-20260801
# Compatible aliases: ChatGPT_API_KEY, Tripo_AI_API_KEY

# Optional backend Blender executable for native .blend export and FBX preview conversion.
BLENDER_BINARY=

# Enable when serving through HTTPS. Keep 0 for local HTTP development.
STUDIO_COOKIE_SECURE=0

# Required for new registrations. Backend-only, comma-separated, case-sensitive passes.
# Empty means registration is closed. Choose long random values and restart after changes.
# Passes are reusable; removing a pass blocks future registrations, not existing accounts.
STUDIO_REGISTRATION_PASSES=

# 1 = offline load testing; real providers are replaced and vendor calls blocked.
STUDIO_LOAD_TEST=0
STUDIO_MOCK_DELAY_MS=250
STUDIO_MOCK_FAILURE_RATE=0
